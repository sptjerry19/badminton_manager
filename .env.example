PORT=3000
APP_PASSWORD=
ADMIN_PASSWORD=
SESSION_SECRET=
POSTGRES_URL=postgresql://user:password@host:5432/dbname?sslmode=verify-full
CRON_SECRET=
GOOGLE_SHEET_ID=your_spreadsheet_id

# Cach 1: dung file credentials local
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# Cach 2: dung JSON trong env (thuan tien deploy)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# Firebase Cloud Messaging. Web config nam trong public/firebase-config.js.
# VAPID: Firebase Console > Project settings > Cloud Messaging > Web Push certificates.
FIREBASE_VAPID_KEY=
# Service account JSON (Project settings > Service accounts > Generate new private key).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"badminton-e1571",...}
# Hoac tach rieng:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Link mo khi bam thong bao. Vi du https://ten-app.vercel.app
APP_BASE_URL=

# Backup Postgres (khong dung Google Sheets lam backup day du).
# URL truc tiep; neu bo trong thi dung POSTGRES_URL (Neon tu bo -pooler).
# POSTGRES_BACKUP_URL=postgresql://user:password@direct-host/database?sslmode=verify-full
# DB khoi phuc thu phai trong va ten badminton_restore_<ten>.
# POSTGRES_RESTORE_URL=postgresql://user:password@localhost:5432/badminton_restore_weekly?sslmode=disable
# Chon major client theo server; nguon hien tai dung Postgres 17.
# POSTGRES_TOOLS_IMAGE=postgres:17
# Hoac cong cu native, khong dat POSTGRES_TOOLS_IMAGE:
# PG_BIN_DIR=C:/Program Files/PostgreSQL/17/bin

# Migration va TLS (khong tu migrate luc startup).
# POSTGRES_MIGRATION_URL=postgresql://migration_user:password@direct-host/database?sslmode=verify-full
# POSTGRES_CA_FILE=C:/secure/postgres-ca.pem
# Production: NODE_ENV=production; ADMIN_PASSWORD >=12 ky tu,
# SESSION_SECRET va CRON_SECRET >=32 ky tu, dung gia tri rieng.
