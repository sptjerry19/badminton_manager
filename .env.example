PORT=3000
APP_PASSWORD=123456
ADMIN_PASSWORD=123456
SESSION_SECRET=change_me_please
POSTGRES_URL=postgres://user:pass@host:5432/dbname
CRON_SECRET=replace_with_secure_random_string
GOOGLE_SHEET_ID=your_spreadsheet_id

# Cach 1: dung file credentials local
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# Cach 2: dung JSON trong env (thuan tien deploy)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# Firebase Cloud Messaging. Web config nam trong public/firebase-config.js.
# VAPID: Firebase Console > Project settings > Cloud Messaging > Web Push certificates.
FIREBASE_VAPID_KEY=
# Service account JSON (Project settings > Service accounts > Generate new private key).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"badminton-e1571",...}
# Hoac tach rieng:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Link mo khi bam thong bao. Vi du https://ten-app.vercel.app
APP_BASE_URL=

# Lich theme theo gio Viet Nam (Asia/Ho_Chi_Minh).
# MM-DD: lap lai hang nam. YYYY-MM-DD: mot khoang ngay cu the.
# START bao gom ngay do; END khong bao gom ngay do. De trong ca hai de tat theme trong lich.
# START va END cua cung mot theme phai khac nhau. Khi chong lich: khoang co START gan nhat duoc uu tien.
THEME_HALLOWEEN_START=10-24
THEME_HALLOWEEN_END=11-10
THEME_WOMENS_DAY_START=10-15
THEME_WOMENS_DAY_END=10-24
THEME_TEACHERS_DAY_START=11-10
THEME_TEACHERS_DAY_END=12-01
THEME_MENS_DAY_START=04-01
THEME_MENS_DAY_END=04-10
THEME_CHRISTMAS_START=12-15
THEME_CHRISTMAS_END=01-02
# Vi du khoang mo theme Tet; admin chinh theo lich am cua tung nam.
THEME_TET_START=2027-01-25
THEME_TET_END=2027-02-20
THEME_REUNIFICATION_START=04-24
THEME_REUNIFICATION_END=05-05
THEME_NATIONAL_DAY_START=08-26
THEME_NATIONAL_DAY_END=09-06
