{
  "name": "badminton-group-manager",
  "version": "1.0.0",
  "description": "Web app quan ly diem danh, tinh phi va cong no nhom cau long",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:backup": "node scripts/postgres-backup.js backup",
    "db:restore": "node scripts/postgres-backup.js restore",
    "db:verify": "node scripts/postgres-backup.js verify",
    "test:backup": "node --test scripts/postgres-backup.test.js",
    "db:drill": "node scripts/verify-backup-local.js",
    "test:money": "node scripts/test-money.js",
    "test": "node scripts/test-money.js --all",
    "db:migrate": "node scripts/database.js migrate",
    "db:status": "node scripts/database.js status",
    "db:seed-demo": "node scripts/database.js seed-demo",
    "db:prune-sessions": "node scripts/database.js prune-sessions",
    "config:check": "node scripts/check-config.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "firebase-admin": "^14.5.0",
    "googleapis": "^140.0.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
